# Copie para .env.local se quiser alterar algum padrão. Nenhuma variável é obrigatória para rodar localmente.

# Segredo de assinatura dos tokens JWT (mínimo de 32 caracteres).
# Se ausente, um segredo aleatório é gerado em data/jwt-secret na primeira execução.
# JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-de-32+caracteres

# Caminho do arquivo SQLite (padrão: data/vetcare.db).
# VETCARE_DB=data/vetcare.db

# Fuso horário da clínica, usado para "hoje" e para bloquear horários passados (padrão: America/Bahia).
# VETCARE_TZ=America/Bahia

# Defina como 0 para iniciar com o banco vazio, sem usuários, profissionais e dados de demonstração.
# VETCARE_SEED=0
